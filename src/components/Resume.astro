---
import { education, experience } from "../data/resume.js";
import Skills from "./Skills.astro";
import { profile } from "../data/profile.js";
import { sitePath } from "../lib/urls.js";

const timelines = [
  { title: "Education", items: education },
  { title: "Experience", items: experience }
];
---

<article class="resume" data-page="resume">
  <header class="section-header">
    <p class="eyebrow">Background</p>
    <h2 class="h2 article-title">Resume</h2>
    <a class="btn btn-primary resume-download" href={sitePath(profile.hero.cvUrl)} download data-track="cv_download" data-track-label="resume">Download CV (PDF)</a>
  </header>

  {timelines.map((timeline) => (
    <section class="timeline">
      <div class="title-wrapper">
        <div class="icon-box"><ion-icon name="book-outline" aria-hidden="true"></ion-icon></div>
        <h3 class="h3">{timeline.title}</h3>
      </div>

      <ol class="timeline-list">
        {timeline.items.map((item) => (
          <li class="timeline-item">
            <h4 class="h4 timeline-item-title">{item.title}</h4>
            <span>{item.period}</span>
            {item.text && <p class="timeline-text">{item.text}</p>}
            {item.highlights && (
              <ul class="timeline-highlights">
                {item.highlights.map((highlight) => <li class="timeline-text">{highlight}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>
  ))}

  <Skills />
</article>
