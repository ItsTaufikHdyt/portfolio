---
import { getMediumArticles } from "../lib/medium.js";
import { medium } from "../data/medium.js";
import BlogCard from "./BlogCard.astro";
import CommercialCTA from "./common/CommercialCTA.astro";
import { sitePath } from "../lib/urls.js";

const articles = await getMediumArticles();
---

<article class="blog" data-page="blog">
  <header class="section-header">
    <p class="eyebrow">Writing</p>
    <h2 class="h2 article-title">Blog</h2>
  </header>

  <section class="blog-posts">
    <ul class="blog-posts-list">
      {articles.length ? (
        articles.map((article) => <BlogCard article={article} />)
      ) : (
        <li class="blog-status">
          <p>Articles are temporarily unavailable.</p>
          <a href={medium.profileUrl} target="_blank" rel="noopener noreferrer">View my articles on Medium</a>
        </li>
      )}
    </ul>
  </section>

  <CommercialCTA
    eyebrow="From reading to building"
    title="Building with Laravel, GIS, or production infrastructure?"
    description="Explore a practical starter kit, or discuss the service you need without turning the articles into sales content."
    primary={{ label: "Explore Products", href: sitePath("/products"), track: "blog_to_product", trackLabel: "blog_footer" }}
    secondary={{ label: "Explore Services", href: sitePath("/services"), track: "blog_to_service", trackLabel: "blog_footer" }}
    compact
  />
</article>
