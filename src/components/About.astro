---
import { sitePath } from "../lib/urls.js";
import { asset } from "../lib/assets.js";
import { profile } from "../data/profile.js";
import { featuredProjects } from "../data/projects.js";
import { serviceHighlights } from "../data/services.js";
import { socials } from "../data/socials.js";
import ServiceCard from "./services/ServiceCard.astro";
import BlogCard from "./BlogCard.astro";
import { getFeaturedArticles } from "../lib/medium.js";

const heroLinks = [
  ...socials.filter((social) => ["GitHub", "LinkedIn"].includes(social.name)),
  { name: "Email", url: `mailto:${profile.email}`, icon: "mail-outline" }
];
const featuredArticles = await getFeaturedArticles();
---

<article class="about active" data-page="about">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-portrait">
      <img src={asset(profile.avatar)} alt={profile.name} width="400" height="500" fetchpriority="high" />
      <span>{profile.name} / {profile.shortLocation}</span>
    </div>
    <div class="hero-copy">
      <p class="eyebrow">{profile.hero.eyebrow}</p>
      <h2 class="hero-title" id="hero-title">{profile.hero.title} <mark>{profile.hero.titleHighlight}</mark></h2>
      <p class="hero-text">{profile.hero.text}</p>
      <div class="hero-actions">
        <button class="btn btn-primary" type="button" data-nav-target="portfolio">View Projects</button>
        <a class="btn btn-secondary" href={sitePath(profile.hero.cvUrl)} download data-track="cv_download" data-track-label="hero">Download CV (PDF)</a>
      </div>
      <ul class="hero-links" aria-label="Profiles and contact">
        {heroLinks.map((link) => (
          <li>
            <a class="hero-link" href={link.url} aria-label={link.name} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}>
              <ion-icon name={link.icon} aria-hidden="true"></ion-icon>
            </a>
          </li>
        ))}
      </ul>
      <a class="hero-collab" href={sitePath("/services")} data-track="homepage_service_cta" data-track-label="work_with_me">Open to freelance projects — see services →</a>
    </div>
    <div class="hero-previews" aria-label="Selected projects">
      <p class="eyebrow">From the portfolio</p>
      {featuredProjects.map((project) => (
        <a class="hero-preview" href={sitePath(`/portfolio/${project.id}`)}>
          <img src={asset(project.image)} alt="" width="120" height="90" loading="lazy" />
          <span><strong>{project.title}</strong><small>{project.category}</small></span>
        </a>
      ))}
    </div>
  </section>

  <section class="discovery" aria-labelledby="discovery-title">
    <div>
      <p class="eyebrow">Explore / Digital work</p>
      <h2 id="discovery-title">Looking for something? <mark>Find it here.</mark></h2>
      <p>Browse real work in web development and geospatial technology.</p>
    </div>
    <form class="discovery-form" data-discovery-form role="search">
      <label class="sr-only" for="discovery-query">Search projects</label>
      <input id="discovery-query" type="search" placeholder="Search WebGIS, Laravel, GIS..." autocomplete="off" data-discovery-input />
      <button type="submit">Search projects</button>
    </form>
  </section>

  <section class="home-featured" aria-labelledby="featured-title">
    <div class="catalog-heading"><div><p class="eyebrow">Selected from real work</p><h2 id="featured-title">Featured work</h2></div><button type="button" class="catalog-link" data-nav-target="portfolio">See all projects</button></div>
    <div class="featured-grid">
      {featuredProjects.map((project) => (
        <a class="featured-card" href={sitePath(`/portfolio/${project.id}`)}>
          <img src={asset(project.image)} alt="" width="480" height="320" loading="lazy" />
          <span class="featured-card-body"><small>{project.category}</small><strong>{project.title}</strong><span>{project.problem}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-about" aria-labelledby="about-title">
    <div><p class="eyebrow">Meet the maker</p><h2 id="about-title">Hi, I'm {profile.name}.</h2><p class="home-about-meta">{profile.role} / {profile.shortLocation}</p></div>
    <div class="about-text">{profile.about.map((paragraph) => <p>{paragraph}</p>)}</div>
  </section>

  {featuredArticles.length > 0 && (
    <section class="blog home-writing" aria-labelledby="writing-title">
      <div class="catalog-heading"><div><p class="eyebrow">Technical writing</p><h2 id="writing-title">From the blog</h2></div><button type="button" class="catalog-link" data-nav-target="blog">All articles</button></div>
      <ul class="blog-posts-list">{featuredArticles.map((article) => <BlogCard article={article} />)}</ul>
    </section>
  )}

  <section class="service">
    <div class="catalog-heading"><div><p class="eyebrow">How I can help</p><h2>What can I build for you?</h2></div><a class="catalog-link" href={sitePath("/services")}>All services</a></div>
    <ul class="service-list">{serviceHighlights.map((service, index) => <ServiceCard service={service} index={index} compact />)}</ul>
  </section>
</article>
