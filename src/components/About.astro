---
import { sitePath } from "../lib/urls.js";
import { profile } from "../data/profile.js";
import { serviceHighlights } from "../data/services.js";
import ServiceCard from "./services/ServiceCard.astro";
---

<article class="about active" data-page="about">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">{profile.hero.eyebrow}</p>
      <h2 class="hero-title" id="hero-title">{profile.hero.title}</h2>
      <p class="hero-text">{profile.hero.text}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={sitePath("/services")} data-track="homepage_service_cta" data-track-label="work_with_me">Work With Me</a>
        <button class="btn btn-secondary" type="button" data-nav-target="portfolio">View My Work</button>
        <a class="btn btn-secondary" href={sitePath("/products")} data-track="homepage_product_cta" data-track-label="explore_products">Explore Products</a>
      </div>
    </div>

    <aside class="hero-details" aria-label="Professional details">
      {profile.hero.details.map((detail) => (
        <div class="hero-detail">
          <span>{detail.label}</span>
          <strong>{detail.value}</strong>
        </div>
      ))}
    </aside>
  </section>

  <header class="section-header">
    <p class="eyebrow">About</p>
    <h2 class="h2 article-title">About me</h2>
  </header>

  <section class="about-text">
    {profile.about.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <section class="service">
    <div class="service-preview-heading">
      <div>
        <p class="eyebrow">Services</p>
        <h3 class="h3 service-title">What I Can Help With</h3>
      </div>
      <a class="service-preview-link" href={sitePath("/services")} data-track="homepage_service_cta" data-track-label="service_preview">
        Explore Services <ion-icon name="arrow-forward-outline" aria-hidden="true"></ion-icon>
      </a>
    </div>
    <ul class="service-list">
      {serviceHighlights.map((service) => <ServiceCard service={service} compact />)}
    </ul>
  </section>
</article>
